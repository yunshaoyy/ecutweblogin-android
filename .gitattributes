# 统一行尾：仓库内一律存 LF，检出时也用 LF。
# 避免 Windows(core.autocrlf=true) 与 macOS/Linux/CI 之间来回转换产生伪 diff。
* text=auto eol=lf

# Windows 脚本必须 CRLF，否则 cmd 解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf

# 二进制文件：禁止任何行尾/编码转换与文本 diff
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.bmp      binary
*.jar      binary
*.war      binary
*.aar      binary
*.apk      binary
*.aab      binary
*.ap_      binary
*.dex      binary
*.dm       binary
*.so       binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jks      binary
*.keystore binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.bin      binary

# Gradle wrapper 脚本在任何平台都要保持 LF
gradlew text eol=lf
